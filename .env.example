# Application
NODE_ENV=development
BUILD_TARGET=dev
PORT=3000

# URLs
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXTAUTH_URL=http://localhost:3000

# Database
DATABASE_URL=postgresql://bloguser:blogpass@localhost:5432/blogdb?schema=public
DIRECT_URL=postgresql://bloguser:blogpass@localhost:5432/blogdb?schema=public

# Redis Cache
REDIS_URL=redis://localhost:6379
UPSTASH_REDIS_REST_URL=http://localhost:6379
UPSTASH_REDIS_REST_TOKEN=

# Authentication
NEXTAUTH_SECRET=your-secret-key-change-in-production

# OpenAI Configuration
OPENAI_API_KEY=sk-your-openai-api-key
OPENAI_MODEL=gpt-4o-mini

# Pinecone Vector Database
PINECONE_API_KEY=your-pinecone-api-key
PINECONE_ENVIRONMENT=your-environment
PINECONE_INDEX=blog-content

# Cloudinary (Image Storage)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=

# AWS S3 (Alternative Image Storage)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=
AWS_S3_BUCKET=

# Email (Optional - for notifications)
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=

# Monitoring (Optional)
SENTRY_DSN=
SENTRY_AUTH_TOKEN=
NEXT_PUBLIC_SENTRY_DSN=

# Analytics (Optional)
NEXT_PUBLIC_GOOGLE_ANALYTICS=
NEXT_PUBLIC_VERCEL_ANALYTICS_ID=

# Rate Limiting
RATE_LIMIT_WINDOW=60000
RATE_LIMIT_MAX_REQUESTS=10

# Feature Flags
ENABLE_AI_ASSISTANT=true
ENABLE_COMMENTS=false
ENABLE_NEWSLETTER=false

# Development
ANALYZE=false
NEXT_TELEMETRY_DISABLED=1